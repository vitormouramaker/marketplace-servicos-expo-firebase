rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- FUNÇÕES AUXILIARES ---
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }
    // Campos do perfil controlados apenas pelas Cloud Functions (carteira, assinatura,
    // cotas, contadores e moderação). O app nunca pode gravá-los diretamente.
    function serverManagedUserFields() {
      return ['walletBalance', 'isPremium', 'premiumExpiresAt', 'dailyFreePosts',
              'dailyFreeApplications', 'appliedJobs', 'favoritedJobs', 'blockedUsers',
              'viewCountLast7Days', 'dailyViews', 'random', 'status', 'deactivatedAt'];
    }
    // O próprio usuário só pode escolher entre profissional e contratante.
    // O tipo "professional-premium" é atribuído pelo servidor.
    function validProfileType(data) {
      return !('profileType' in data) || data.profileType in ['professional', 'contractor'];
    }
    function isChatParticipant(chatRoomId) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/chat_rooms/$(chatRoomId)).data.participants;
    }

    // --- REGRAS GERAIS ---
    match /categories/{categoryId} {
      allow read: if true;
    }
    match /professions/{professionId} {
      allow read: if true;
    }
    match /profession_suggestions/{suggestionId} {
      allow create: if signedIn();
    }

    // Reserva de CPF (garante um CPF por conta). Só é possível CRIAR o documento,
    // com o próprio uid. Ninguém lê nem sobrescreve, então um CPF já usado falha.
    match /cpf_references/{cpf} {
      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly(['userId'])
                    && request.resource.data.userId == request.auth.uid
                    && cpf.matches('^[0-9]{11}$');
      allow read, update, delete: if false;
    }

    // Pacotes de moedas: leitura para quem está logado; escrita só pelo console / seed.
    match /coin_packages/{packageId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Custos do app (postar vaga, destaque, candidatura...).
    match /app_config/{configId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Registro de pagamentos processados: escrito só pelas Cloud Functions.
    match /transactions/{transactionId} {
      allow read, write: if false;
    }

    // --- REGRAS DAS VAGAS (JOBS) ---
    match /jobs/{jobId} {
      // Qualquer usuário logado pode ler (ver) os detalhes de uma vaga.
      allow read: if signedIn();

      // Criar, editar, fechar e expirar vagas é feito só pelas Cloud Functions
      // (postJob, updateJob, closeJob, expireJobs), que cobram as moedas.
      allow write: if false;

      // Regras para a subcoleção de candidatos
      match /applicants/{applicantId} {
        // Apenas o criador da vaga pode ver a lista de candidatos.
        allow read: if signedIn() && request.auth.uid == get(/databases/$(database)/documents/jobs/$(jobId)).data.postedByUid;
        // Candidatura só pela Cloud Function 'applyToJob'.
        allow write: if false;
      }
    }

    // --- REGRAS DE USUÁRIO E SUBCOLEÇÕES ---
    match /users/{userId} {
      // Perfis são visíveis para quem está logado (o app exige login em todas as telas).
      allow read: if signedIn();

      // Cadastro: o próprio usuário cria o perfil, com carteira zerada e sem campos do servidor.
      allow create: if isOwner(userId)
                    && request.resource.data.get('walletBalance', 0) == 0
                    && !request.resource.data.keys().hasAny(serverManagedUserFields().removeAll(['walletBalance']))
                    && validProfileType(request.resource.data);

      // Edição do perfil: qualquer campo, exceto os controlados pelo servidor.
      allow update: if isOwner(userId)
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(serverManagedUserFields())
                    && validProfileType(request.resource.data);

      // A exclusão da conta é feita pela função agendada após a desativação.
      allow delete: if false;

      // Dados privados (CPF, tokens de push): só o dono.
      match /private/{docId} {
        allow read, write: if isOwner(userId);
      }

      // Notificações: criadas pelas Cloud Functions; o dono lê, marca como lida e apaga.
      match /notifications/{notificationId} {
        allow read, update, delete: if isOwner(userId);
        allow create: if false;
      }

      match /portfolio/{itemId} {
        allow read: if true;
        allow write: if isOwner(userId);
      }
      match /userProfessions/{professionId} {
        allow read, write: if isOwner(userId);
      }
      match /reviews/{reviewId} {
        // Qualquer um pode ler as avaliações.
        allow read: if true;

        // Avaliação: logado, não para si mesmo, assinada com o próprio uid e nota de 1 a 5.
        allow create: if signedIn()
                      && request.auth.uid != userId
                      && request.resource.data.reviewerId == request.auth.uid
                      && request.resource.data.rating is int
                      && request.resource.data.rating >= 1 && request.resource.data.rating <= 5;

        // Editar só nota e comentário, e só quem escreveu.
        allow update: if signedIn()
                      && request.auth.uid == resource.data.reviewerId
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'comment'])
                      && request.resource.data.rating is int
                      && request.resource.data.rating >= 1 && request.resource.data.rating <= 5;

        allow delete: if signedIn() && request.auth.uid == resource.data.reviewerId;
      }
      match /profileViews/{viewId} {
        allow read, write: if false;
      }
    }

    // --- REGRAS PARA O CHAT ---
    match /chat_rooms/{chatRoomId} {
      // Listar só as salas de que o usuário participa. A consulta do app precisa usar
      // where('participants', 'array-contains', uid), senão é negada inteira.
      allow list: if signedIn() && request.auth.uid in resource.data.participants;

      // Ler UMA sala: só participantes.
      allow get: if signedIn() && request.auth.uid in resource.data.participants;

      // Criar a sala: exatamente 2 participantes, incluindo quem cria, e o id
      // determinístico "<uidMenor>_<uidMaior>" usado pelo app.
      allow create: if signedIn()
                    && request.resource.data.participants.size() == 2
                    && request.auth.uid in request.resource.data.participants
                    && chatRoomId == request.resource.data.participants[0] + '_' + request.resource.data.participants[1];

      // Participante atualiza a sala (lastMessage etc.), sem trocar os participantes.
      allow update: if signedIn()
                    && request.auth.uid in resource.data.participants
                    && request.resource.data.participants == resource.data.participants;

      // Participante pode apagar a sala.
      allow delete: if signedIn() && request.auth.uid in resource.data.participants;

      // Subcoleção de mensagens
      match /messages/{messageId} {
        // Ler: só participantes da sala.
        allow read: if isChatParticipant(chatRoomId);

        // Criar: participante da sala, e o remetente é o próprio usuário.
        allow create: if isChatParticipant(chatRoomId)
                      && request.auth.uid == request.resource.data.senderId;

        // Ninguém pode excluir fisicamente a mensagem.
        allow delete: if false;

        // Atualizar (soft delete)
        allow update: if
          // Apagar para todos: só o remetente.
          (
            signedIn() &&
            request.auth.uid == resource.data.senderId &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'mediaURL', 'mediaType', 'fileName', 'durationMillis', 'fileSize', 'deletedForAll']) &&
            request.resource.data.deletedForAll == true
          )
          ||
          // Apagar para mim: participante, alterando só 'deletedFor' para a lista antiga + o próprio uid.
          (
            isChatParticipant(chatRoomId) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedFor']) &&
            request.resource.data.deletedFor == resource.data.get('deletedFor', []).concat([request.auth.uid])
          );
      }
    }
  }
}
