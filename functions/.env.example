# Copie para functions/.env (lido pelas Cloud Functions no deploy e no emulador). Tudo opcional.

# Segredo da assinatura do webhook (painel do Mercado Pago > Webhooks). Se definido,
# notificações sem x-signature válida são recusadas.
MERCADOPAGO_WEBHOOK_SECRET=
# URL pública da função paymentWebhook (enviada como notification_url na preferência).
MERCADOPAGO_WEBHOOK_URL=
# Para onde o checkout volta depois do pagamento.
PAYMENT_BACK_URL_SUCCESS=https://example.com/success
PAYMENT_BACK_URL_FAILURE=https://example.com/failure
PAYMENT_BACK_URL_PENDING=https://example.com/pending
