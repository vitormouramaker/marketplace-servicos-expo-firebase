{
  "name": "proconecta-functions",
  "scripts": {
    "lint": "eslint .",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && npx --yes firebase-tools@14 emulators:start --only functions --project demo-proconecta",
    "shell": "npm run build && npx --yes firebase-tools@14 functions:shell",
    "start": "npm run shell",
    "deploy": "npx --yes firebase-tools@14 deploy --only functions",
    "logs": "npx --yes firebase-tools@14 functions:log",
    "seed:demo": "node scripts/seed-demo.js"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^6.0.1",
    "mercadopago": "^2.8.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "@typescript-eslint/parser": "^5.12.0",
    "eslint": "^8.9.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "firebase-functions-test": "^3.1.0",
    "typescript": "^5.7.3"
  },
  "private": true,
  "license": "UNLICENSED"
}
