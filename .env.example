# Copie para .env (o Expo carrega automaticamente as variáveis EXPO_PUBLIC_*).
# Sem nenhuma variável, o app usa o projeto "demo-proconecta" com os emuladores locais.

# --- Firebase (só para usar um projeto real seu) -----------------------------
# Console do Firebase > Configurações do projeto > Seus apps > App da Web.
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# --- Emuladores ---------------------------------------------------------------
# "true" força os emuladores, "false" desliga (padrão: ligado quando o projeto começa com "demo-").
EXPO_PUBLIC_USE_FIREBASE_EMULATORS=
# Host dos emuladores visto pelo app. Padrão: localhost (iOS/web) e 10.0.2.2 (emulador Android).
# Em aparelho físico com Expo Go, use o IP da sua máquina na rede local, ex.: 192.168.0.10
EXPO_PUBLIC_EMULATOR_HOST=

# --- Build nativo (opcional) ---------------------------------------------------
# Id do projeto no EAS (liga o push do Expo). Sem ele, o registro de push é ignorado.
EAS_PROJECT_ID=
EXPO_OWNER=
ANDROID_PACKAGE=
IOS_BUNDLE_IDENTIFIER=
# Caminho do google-services.json do SEU projeto Firebase (só para builds Android com FCM).
GOOGLE_SERVICES_JSON=
